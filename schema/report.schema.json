    "SeverityLevel": {
      "description": "How severe or impactful a risk is.\n\nSeparate from confidence (data reliability). A risk can be HIGH severity\nwith LOW confidence (e.g., unconfirmed but potentially catastrophic).",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "title": "SeverityLevel",
      "type": "string"
    },
    "SourceRef": {
      "description": "A single source reference with provenance tier.\n\nretrieved_at is always null in P1 \u2014 it is part of the eventual P2/P3 contract\nwhere passage-level evidence is captured at retrieval time.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/SourceTier",
          "default": "unknown"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
