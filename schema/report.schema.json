      "title": "SourceRef",
      "type": "object"
    },
    "SourceTier": {
      "description": "Provenance tier for a source URL.\n\nMirrors the tiered source model in docs/STRATEGY.md \u00a73 Priority 3.\nP1: tier is inferred from domain patterns by the assembler.\nP3: tier will be recorded at retrieval time by the source registry.",
      "enum": [
        "primary_document",
        "reputable_secondary",
        "aggregator",
        "community",
        "unknown"
      ],
      "title": "SourceTier",
      "type": "string"
    }
  },
  "description": "Canonical due diligence report \u2014 the source of truth for all renderers.\n\nEvery run produces one ReportDocument, written to outputs/report_{slug}.json.\nThe markdown, PDF, and HTML files are renders of this document, not edited\nindependently.\n\nschema_version follows the policy in SCHEMA_VERSION above.",
  "properties": {
    "schema_version": {
      "default": "1.0.7",
      "description": "Schema version. See SCHEMA_VERSION in models.py for the versioning policy.",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "description": "trace_id of the pipeline run that produced this report",
      "title": "Report Id",
      "type": "string"
    },
    "company_name": {
      "title": "Company Name",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "run_metadata": {
      "$ref": "#/$defs/RunMetadata"
    },
    "synthesis": {
